{
  "name": "iris-screenshot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "native:build": "cargo build --locked --manifest-path src-tauri/Cargo.toml",
    "native:diagnose": "pnpm native:build && node tests/native-runner.mjs diagnose",
    "test:native": "pnpm native:build && node --test tests/native-*.test.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm build && pnpm test && pnpm test:native && pnpm test:rust",
    "format": "prettier --write src tests vite.config.ts vitest.config.ts tsconfig.json package.json src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src tests vite.config.ts vitest.config.ts tsconfig.json package.json src-tauri/*.json src-tauri/capabilities/*.json",
    "dmg": "tauri build --bundles dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
