{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window may call the capture commands.",
  "windows": ["main"],
  "permissions": [
    "allow-diagnose",
    "allow-request-permission",
    "allow-list-sources",
    "allow-library",
    "allow-library-image",
    "allow-capture",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-recording-status",
    "allow-save-edit",
    "allow-export-image",
    "allow-library-action",
    "allow-copy-text",
    "allow-open-permissions",
    "allow-choose-directory",
    "allow-update-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-import-image",
    "core:window:allow-minimize"
  ]
}
